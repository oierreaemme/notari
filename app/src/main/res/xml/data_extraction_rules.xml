<?xml version="1.0" encoding="utf-8"?>
<!--
  Notes contain intimate user content. We exclude EVERYTHING from cloud backup
  and from device-to-device transfer. See ADR 0002 for the privacy rationale.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
